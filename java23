class Solution {
    public boolean sumGame(String num) {
        int n = num.length();
        int half = n / 2;

        int sumLeft = 0;
        int sumRight = 0;
        int qLeft = 0;
        int qRight = 0;

        for (int i = 0; i < half; i++) {
            if (num.charAt(i) == '?') {
                qLeft++;
            } else {
                sumLeft += num.charAt(i) - '0';
            }
        }

        for (int i = half; i < n; i++) {
            if (num.charAt(i) == '?') {
                qRight++;
            } else {
                sumRight += num.charAt(i) - '0';
            }
        }

        // If the number of ? is odd, Alice can always
        // make the final sums unequal.
        if ((qLeft + qRight) % 2 == 1) {
            return true;
        }

        // Difference between the known sums
        int diff = sumLeft - sumRight;

        // If there are more ? on the left, their net effect
        // can be controlled by Alice/Bob.
        if (qLeft > qRight) {
            diff += (qLeft - qRight) * 9 / 2;
        } else {
            diff -= (qRight - qLeft) * 9 / 2;
        }

        // If the adjusted difference is non-zero, Alice wins.
        return diff != 0;
    }
}
