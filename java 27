class Solution {
    public String lexGreaterPermutation(String s, String target) {
        int n = s.length();

        int[] freq = new int[26];

        // Count characters in s
        for (char ch : s.toCharArray()) {
            freq[ch - 'a']++;
        }

        // Characters available after matching target[0..i-1]
        int[] remaining = freq.clone();

        String best = "";

        for (int i = 0; i < n; i++) {
            int t = target.charAt(i) - 'a';

            // Try to make the first difference at position i.
            // We have NOT removed target[i] yet.
            for (int c = t + 1; c < 26; c++) {
                if (remaining[c] > 0) {

                    StringBuilder candidate = new StringBuilder(n);

                    // Prefix equal to target
                    candidate.append(target, 0, i);

                    // First character greater than target[i]
                    candidate.append((char) ('a' + c));

                    // Remove the chosen character
                    int[] rest = remaining.clone();
                    rest[c]--;

                    // Put all remaining characters in sorted order
                    for (int x = 0; x < 26; x++) {
                        while (rest[x] > 0) {
                            candidate.append((char) ('a' + x));
                            rest[x]--;
                        }
                    }

                    String cur = candidate.toString();

                    if (best.isEmpty() || cur.compareTo(best) < 0) {
                        best = cur;
                    }

                    // The smallest character > target[i] is optimal
                    // for this position.
                    break;
                }
            }

            // Now consume target[i] so we can continue
            // matching the target prefix.
            if (remaining[t] == 0) {
                break;
            }

            remaining[t]--;
        }

        return best;
    }
}
